rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSmallImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // New paths written by the app: {kind}/{uid}/{file}
    match /profile_images/{uid}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSmallImage();
      allow delete: if isOwner(uid);
    }

    match /medicine_images/{uid}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSmallImage();
      allow delete: if isOwner(uid);
    }

    match /invoice_images/{uid}/{file} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid) && isSmallImage();
    }

    // Images uploaded by earlier app versions (read-only now).
    match /Medicines/{uid}/{file} {
      allow read: if true;
      allow delete: if isOwner(uid);
    }
    match /Invoices/{uid}/{file} {
      allow read, delete: if isOwner(uid);
    }
    match /Profile/{uid} {
      allow read: if true;
    }
  }
}
